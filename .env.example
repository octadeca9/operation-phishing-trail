# Salin ke .env lalu sesuaikan. JANGAN commit .env.
APP_ENV=development
PORT=8080
LOG_LEVEL=info

# Identitas: "mock" HANYA untuk dev lokal. Untuk publik gunakan "platform".
AUTH_MODE=mock

CHALLENGE_DIR=/opt/challenge
CHALLENGE_ID=operation-phishing-trail

SESSION_TTL_SECONDS=7200
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_SECONDS=60

# Isi hanya jika integrasi platform induk membutuhkannya (lihat PRD §12/16).
# PLATFORM_BASE_URL=
# PLATFORM_ISSUER=
# PLATFORM_AUDIENCE=
# PLATFORM_CLIENT_ID=
# PLATFORM_CLIENT_SECRET=
# DATABASE_URL=
